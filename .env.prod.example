# Продакшен-конфигурация для docker-compose.prod.yml на Beget VPS.
# Отличия от .env.example (локальная разработка):
#   - хост БД — "postgres" (имя сервиса в docker-сети), не "localhost"
#   - POSTGRES_PASSWORD нужен для docker-compose.prod.yml (${POSTGRES_PASSWORD}
#     в конфиге контейнера postgres) — значение должно совпадать с паролем в
#     DATABASE_URL ниже, pydantic-settings не умеет ссылаться на другие переменные
#   - все значения — настоящие секреты, никогда не коммитить .env с реальными
#     значениями (см. .gitignore)

TELEGRAM_BOT_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://arina:<то же значение, что в POSTGRES_PASSWORD>@postgres:5432/arina
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ВАЖНО: сгенерировать один раз (python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())") и никогда не менять после того, как в БД
# появятся зашифрованные данные — смена ключа делает существующие записи
# нерасшифровываемыми безвозвратно.
FERNET_KEY=

# Список Telegram ID, кому разрешён доступ в закрытую бету — расширяется по мере
# приглашения новых людей.
ALLOWED_USER_IDS=
