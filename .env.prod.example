# Продакшен-конфигурация для docker-compose.prod.yml на Beget VPS.
# Отличия от .env.example (локальная разработка):
#   - хост БД — "postgres" (имя сервиса в docker-сети), не "localhost"
#   - POSTGRES_PASSWORD нужен для docker-compose.prod.yml (${POSTGRES_PASSWORD}
#     в конфиге контейнера postgres) — значение должно совпадать с паролем в
#     DATABASE_URL ниже, pydantic-settings не умеет ссылаться на другие переменные
#   - все значения — настоящие секреты, никогда не коммитить .env с реальными
#     значениями (см. .gitignore)

TELEGRAM_BOT_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://arina:<то же значение, что в POSTGRES_PASSWORD>@postgres:5432/arina

# ВАЖНО (найдено 2026-08-20 при реальном деплое): с российских IP (в т.ч. Beget)
# OpenRouter отвечает 403 на любой запрос — гео-блокировка на уровне их WAF, не
# проблема с ключом. Прямой https://openrouter.ai/api/v1 работает только при
# локальной разработке (с обычного IP), НЕ работает в проде на Beget. В проде
# нужен релей — см. https://github.com/elenakolodnitskay-web/arina-openrouter-relay
# (задеплоен на Render.com, не Cloudflare — Cloudflare Workers не помогают, см.
# Plan.md, раздел «Блокер верхнего уровня», за объяснением почему).
OPENROUTER_BASE_URL=https://arina-openrouter-relay.onrender.com/api/v1
OPENROUTER_API_KEY=

# ВАЖНО: сгенерировать один раз (python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())") и никогда не менять после того, как в БД
# появятся зашифрованные данные — смена ключа делает существующие записи
# нерасшифровываемыми безвозвратно.
FERNET_KEY=

# Список ID (Telegram и MAX — общий whitelist на обе платформы, см. Plan.md про
# известное упрощение), кому разрешён доступ в закрытую бету — расширяется по мере
# приглашения новых людей.
ALLOWED_USER_IDS=

# MAX (мессенджер) — необязательные. Если MAX_BOT_TOKEN не задан, вебхук-сервер MAX
# просто не запускается, остальной бот работает как обычно.
# Токен — через @MasterBot в самом MAX (/create).
MAX_BOT_TOKEN=
# Секрет для проверки, что вебхук реально пришёл от MAX (см. DEPLOY.md, раздел MAX,
# для регистрации через POST /subscriptions с этим же значением).
MAX_WEBHOOK_SECRET=
